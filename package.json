{
  "name": "taxflow-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "db:push": "drizzle-kit push --config drizzle.taxflow.config.ts",
    "db:push:tin": "drizzle-kit push --config drizzle.tin.config.ts",
    "db:push:all": "pnpm db:push && pnpm db:push:tin",
    "db:migrate": "drizzle-kit migrate --config drizzle.taxflow.config.ts",
    "db:migrate:tin": "drizzle-kit migrate --config drizzle.tin.config.ts",
    "db:pull": "drizzle-kit pull --config drizzle.taxflow.config.ts",
    "db:pull:tin": "drizzle-kit pull --config drizzle.tin.config.ts",
    "db:seed": "tsx db/seeds/taxflow.seed.ts",
    "db:seed:tin": "tsx db/seeds/tin.seed.ts",
    "db:seed:supply": "tsx db/seeds/supply-chain.seed.ts",
    "db:seed:all": "pnpm db:seed:tin && pnpm db:seed && pnpm db:seed:supply",
    "db:setup": "tsx db/setup.ts",
    "db:studio": "drizzle-kit studio --config drizzle.taxflow.config.ts",
    "db:studio:tin": "drizzle-kit studio --config drizzle.tin.config.ts",
    "db:seed:neon": "tsx db/seeds/neon/taxflow-neon.seed.ts",
    "db:seed:neon:tin": "tsx db/seeds/neon/tin-neon.seed.ts",
    "db:seed:neon:all": "tsx db/seeds/neon/seed-all-neon.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/deepseek": "^2.0.24",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/huggingface": "^1.0.37",
    "@ai-sdk/react": "^3.0.118",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.116",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "geist": "^1.7.0",
    "idb": "^8.0.3",
    "input-otp": "^1.4.2",
    "ioredis": "^5.10.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
