{
  "name": "taxflow-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "ai:eval": "tsx scripts/evaluate-ai.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "db:push": "drizzle-kit push --config drizzle.taxflow.config.ts",
    "db:push:tin": "drizzle-kit push --config drizzle.tin.config.ts",
    "db:push:all": "pnpm db:push && pnpm db:push:tin",
    "db:migrate": "drizzle-kit migrate --config drizzle.taxflow.config.ts",
    "db:migrate:tin": "drizzle-kit migrate --config drizzle.tin.config.ts",
    "db:pull": "drizzle-kit pull --config drizzle.taxflow.config.ts",
    "db:pull:tin": "drizzle-kit pull --config drizzle.tin.config.ts",
    "db:seed": "tsx db/seeds/taxflow.seed.ts",
    "db:seed:tin": "tsx db/seeds/tin.seed.ts",
    "db:seed:supply": "tsx db/seeds/supply-chain.seed.ts",
    "db:seed:all": "pnpm db:seed:tin && pnpm db:seed && pnpm db:seed:supply",
    "db:setup": "tsx db/setup.ts",
    "db:studio": "drizzle-kit studio --config drizzle.taxflow.config.ts",
    "db:studio:tin": "drizzle-kit studio --config drizzle.tin.config.ts",
    "db:seed:neon": "tsx db/seeds/neon/taxflow-neon.seed.ts",
    "db:seed:neon:tin": "tsx db/seeds/neon/tin-neon.seed.ts",
    "db:seed:neon:all": "tsx db/seeds/neon/seed-all-neon.ts",
    "db:seed:full": "tsx db/seeds/neon/taxflow-full.seed.ts",
    "db:seed:full:tin": "tsx db/seeds/neon/tin-full.seed.ts",
    "db:seed:full:all": "tsx db/seeds/neon/seed-all-full.ts",
    "db:seed:test": "tsx db/seeds/test-accounts.seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/deepseek": "^2.0.26",
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/huggingface": "^1.0.39",
    "@ai-sdk/react": "^3.0.136",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@react-email/components": "^1.0.10",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.134",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "geist": "^1.7.0",
    "idb": "^8.0.3",
    "input-otp": "^1.4.2",
    "ioredis": "^5.10.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.564.0",
    "next": "16.2.1",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "redis": "^6.3.0",
    "resend": "^6.9.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.8.1"
}

