# ─────────────────────────────────────────────────────────────────────────────
# TaxFlow Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Main TaxFlow PostgreSQL database
DATABASE_URL="postgresql://user:password@localhost:5432/taxflow"

# Government TIN registry database (read-only)
TIN_DATABASE_URL="postgresql://user:password@localhost:5432/tin_registry"

# ── Authentication ────────────────────────────────────────────────────────────
# better-auth requires these two vars
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-secret-at-least-32-chars-long"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ── Real-time / Caching (Valkey / Redis) ──────────────────────────────────────
# Format: redis://:PASSWORD@HOST:PORT
# For local Valkey (Docker): redis://:yourpassword@localhost:6380
# REQUIRED for real-time notifications and Socket.IO multi-process pub-sub.
# If not set, real-time features are disabled gracefully.
REDIS_URL="redis://:yourpassword@localhost:6380"

# ── AI Providers (Vercel AI SDK) ──────────────────────────────────────────────
# At least one provider is required for the AI chat and intelligence features.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"
GOOGLE_GENERATIVE_AI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxx"
# DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
# HUGGINGFACE_API_KEY="hf_xxxxxxxxxxxxxxxxxxxx"

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
