# Core runtime
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,api.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://api.your-domain.com
DJANGO_LOG_LEVEL=INFO

# Database (Option A: full URL; preferred on Render)
DATABASE_URL=postgresql://taxtrackrwanda:taxtrackrwanda@127.0.0.1:5432/taxtrackrwanda
DB_SSL_REQUIRE=False

# Database (Option B: discrete vars; useful on VPS/docker)
POSTGRES_DB=taxtrackrwanda
POSTGRES_USER=taxtrackrwanda
POSTGRES_PASSWORD=taxtrackrwanda
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1

# Security toggles
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
